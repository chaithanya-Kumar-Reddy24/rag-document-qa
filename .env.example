# Copy this file to ".env" and put your real key in the copy.
# NEVER commit ".env" and never paste a real key into this example file.
OPENAI_API_KEY=your_api_key_here

OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

CHROMA_PERSIST_DIRECTORY=./data/chroma_db

CHUNK_SIZE=1000
CHUNK_OVERLAP=200

TOP_K=4
# Cosine similarity a chunk must reach to be sent to the LLM (0.0 - 1.0).
# See README "Tuning the relevance threshold" before raising this.
RELEVANCE_THRESHOLD=0.3

# Hybrid search (vector + BM25 keyword search, fused and LLM re-ranked).
# Set to false to fall back to vector-only search.
HYBRID_SEARCH=true
# How many candidates the fusion stage keeps before re-ranking/thresholding.
CANDIDATE_POOL_SIZE=20
# Constant in the Reciprocal Rank Fusion formula (higher = flatter weighting
# of rank position). 60 is the commonly used default.
RRF_K=60
